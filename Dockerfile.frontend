FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@latest-10

# Copy workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY src/frontend/package.json ./src/frontend/

# Install all dependencies
RUN pnpm install --no-frozen-lockfile

# Copy all source code
COPY . .

# Build the frontend with MOCK MODE ON (no ICP blockchain needed)
# This fixes the "AuthClient is not initialized" error
WORKDIR /app/src/frontend
RUN VITE_USE_MOCK=true pnpm run build

# ── Production stage ──────────────────────────────────────────────────────────
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/src/frontend/dist /usr/share/nginx/html

# nginx config for SPA (all routes → index.html)
RUN printf 'server {\n\
    listen 3000;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    # Enable gzip\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;\n\
    # SPA routing: all 404s → index.html\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    # Cache static assets\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
